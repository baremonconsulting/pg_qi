SHOW pg_qi.shadow_request_applied;
off
SHOW duckdb.force_execution;
on
SET duckdb.force_execution = off;
SET pg_qi.routing_mode = off;
SELECT id FROM ONLY shadow_plain WHERE id = 1;
1
